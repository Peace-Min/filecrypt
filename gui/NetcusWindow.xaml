<Window x:Class="FileCrypt.NetcusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="근태관리 연동" Height="520" Width="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#FFF7F8FA" FontFamily="Malgun Gothic" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel"  Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="Border1" Color="#FFE4E7EE"/>
        <SolidColorBrush x:Key="Text1"  Color="#FF1D2433"/>
        <SolidColorBrush x:Key="Text2"  Color="#FF5B6373"/>
        <SolidColorBrush x:Key="Accent" Color="#FF3E5BE0"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TxtHead" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource Text1}"/>

        <!-- 로그인 정보 -->
        <Border Grid.Row="1" Margin="0,12,0,0" CornerRadius="8" Padding="12"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource Border1}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="아이디" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource Text2}"/>
                <TextBox   Grid.Column="1" x:Name="TxtId" VerticalContentAlignment="Center" Padding="4,3"/>
                <TextBlock Grid.Column="2" Text="비밀번호" VerticalAlignment="Center" Margin="14,0,8,0"
                           Foreground="{StaticResource Text2}"/>
                <PasswordBox Grid.Column="3" x:Name="TxtPw" VerticalContentAlignment="Center" Padding="4,3"/>
                <TextBlock Grid.Column="4" x:Name="TxtCredNote" VerticalAlignment="Center" Margin="12,0,0,0"
                           FontSize="12" Foreground="{StaticResource Text2}" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- 날짜 -->
        <Border Grid.Row="2" Margin="0,10,0,0" CornerRadius="8" Padding="12"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource Border1}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="시작 날짜" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource Text2}"/>
                    <DatePicker x:Name="DpStart" Width="140" SelectedDateChanged="Dp_Changed"/>
                    <TextBlock x:Name="LbDays" Text="가져올 일수" VerticalAlignment="Center" Margin="16,0,8,0"
                               Foreground="{StaticResource Text2}"/>
                    <TextBox x:Name="TxtDays" Width="60" Text="1" VerticalContentAlignment="Center"
                             Padding="4,3" TextChanged="Dp_Changed"/>
                    <TextBlock x:Name="LbDaysHint" VerticalAlignment="Center" Margin="8,0,0,0"
                               FontSize="12" Foreground="{StaticResource Text2}"/>
                </StackPanel>
                <TextBlock x:Name="TxtPlan" Margin="0,10,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource Text1}"/>
            </StackPanel>
        </Border>

        <!-- 진행 로그 -->
        <Border Grid.Row="3" Margin="0,10,0,0" CornerRadius="8"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource Border1}" BorderThickness="1">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="12">
                <TextBlock x:Name="TxtLog" TextWrapping="Wrap" FontFamily="Consolas, D2Coding, Malgun Gothic"
                           FontSize="12" Foreground="{StaticResource Text2}"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ProgressBar x:Name="Bar" Width="180" Height="4" Margin="0,0,12,0" VerticalAlignment="Center"
                         Visibility="Collapsed" Foreground="{StaticResource Accent}"
                         Background="#FFE6EAF0" BorderThickness="0" IsIndeterminate="True"/>
            <Button x:Name="BtnGo" MinWidth="130" Padding="10,6" Click="BtnGo_Click"/>
            <Button x:Name="BtnClose" Content="닫기" MinWidth="80" Padding="10,6" Margin="8,0,0,0"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
