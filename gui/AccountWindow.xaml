<Window x:Class="FileCrypt.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="계정 정보 관리" Height="380" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FFF7F8FA" FontFamily="Malgun Gothic" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel"   Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="Border1" Color="#FFE4E7EE"/>
        <SolidColorBrush x:Key="Text1"   Color="#FF1D2433"/>
        <SolidColorBrush x:Key="Text2"   Color="#FF5B6373"/>
        <SolidColorBrush x:Key="Accent"  Color="#FF3E5BE0"/>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="근태관리 계정" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource Text1}"/>
        <TextBlock Grid.Row="1" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource Text2}"
                   Text="한 번 저장해 두면 올리기·가져오기 할 때 다시 묻지 않습니다. 비밀번호는 이 PC 에서만 풀리도록 보호해 저장하며, 화면·기록 어디에도 남기지 않습니다."/>

        <Border Grid.Row="2" Margin="0,14,0,0" CornerRadius="8" Padding="14"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource Border1}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="아이디" VerticalAlignment="Center"
                           Margin="0,0,10,0" Foreground="{StaticResource Text2}"/>
                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtId" Padding="5,4"
                           VerticalContentAlignment="Center" TextChanged="Field_Changed"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="비밀번호" VerticalAlignment="Center"
                           Margin="0,10,10,0" Foreground="{StaticResource Text2}"/>
                <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="TxtPw" Margin="0,10,0,0" Padding="5,4"
                             VerticalContentAlignment="Center" PasswordChanged="Field_Changed"/>

                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtPwNote" Margin="0,6,0,0"
                           FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Text2}"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="0,12,0,0" CornerRadius="8" Padding="12"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource Border1}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="TxtState" TextWrapping="Wrap" Foreground="{StaticResource Text1}"/>
                <TextBlock x:Name="TxtDetail" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                           FontFamily="Consolas, D2Coding, Malgun Gothic"
                           Foreground="{StaticResource Text2}"/>
                <TextBlock x:Name="TxtPath" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource Text2}"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <ProgressBar x:Name="Bar" Width="140" Height="4" Margin="0,0,12,0" VerticalAlignment="Center"
                         Visibility="Collapsed" IsIndeterminate="True"
                         Foreground="{StaticResource Accent}" Background="#FFE6EAF0" BorderThickness="0"/>
            <Button x:Name="BtnLog" Content="기록 보기" MinWidth="90" Padding="10,6"
                    Click="BtnLog_Click"
                    ToolTip="문제가 생겼을 때 무엇이 어느 단계에서 어그러졌는지 남겨 둔 기록입니다."/>
            <Button x:Name="BtnForget" Content="저장된 정보 삭제" MinWidth="120" Padding="10,6" Margin="8,0,0,0"
                    Click="BtnForget_Click"/>
            <Button x:Name="BtnTest" Content="로그인 확인" MinWidth="100" Padding="10,6" Margin="8,0,0,0"
                    Click="BtnTest_Click"/>
            <Button x:Name="BtnSave" Content="저장" MinWidth="90" Padding="10,6" Margin="8,0,0,0"
                    Click="BtnSave_Click"/>
            <Button x:Name="BtnClose" Content="닫기" MinWidth="80" Padding="10,6" Margin="8,0,0,0"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
