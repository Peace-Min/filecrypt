<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FileCrypt</AssemblyName>
    <RootNamespace>FileCrypt</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyTitle>FileCrypt</AssemblyTitle>
    <Product>FileCrypt</Product>
    <Version>2.0.0</Version>
    <FileVersion>2.0.0.0</FileVersion>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <NeutralLanguage>ko-KR</NeutralLanguage>
    <ApplicationIcon>FileCrypt.ico</ApplicationIcon>
    <SatelliteResourceLanguages>ko-KR;en</SatelliteResourceLanguages>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- 창 제목 표시줄 아이콘용 (exe 아이콘은 ApplicationIcon 이 담당) -->
    <Resource Include="FileCrypt.ico" />
  </ItemGroup>

</Project>
