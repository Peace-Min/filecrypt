<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- x64 고정. AnyCPU 로 두면 64비트로 실행되면서 WebView2 의 네이티브 로더는 x86 만
         복사돼 0x8007000B(BadImageFormat) 로 죽는다. 큰 파일을 다루므로 32비트
         주소공간(수천만 자 문자열)도 피해야 한다. -->
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>FileCrypt</AssemblyName>
    <RootNamespace>FileCrypt</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyTitle>FileCrypt</AssemblyTitle>
    <Product>FileCrypt</Product>
    <Version>2.0.0</Version>
    <FileVersion>2.0.0.0</FileVersion>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <NeutralLanguage>ko-KR</NeutralLanguage>
    <ApplicationIcon>FileCrypt.ico</ApplicationIcon>
    <SatelliteResourceLanguages>ko-KR;en</SatelliteResourceLanguages>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- 창 제목 표시줄 아이콘용 (exe 아이콘은 ApplicationIcon 이 담당) -->
    <Resource Include="FileCrypt.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 사내 보고 시스템 자동 입력/읽기용. net462 lib 가 있어 net48 에서 동작한다.
         버전을 고정하는 이유: 폐쇄망에서도 로컬 NuGet 캐시로 복원돼야 한다(인터넷 조회 금지). -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3179.45" />
  </ItemGroup>

</Project>
