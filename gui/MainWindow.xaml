<Window x:Class="FileCrypt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FileCrypt"
        Title="FileCrypt" Height="680" Width="900" MinHeight="560" MinWidth="740"
        Icon="FileCrypt.ico"
        Background="{StaticResource Bg}"
        FontFamily="Malgun Gothic" FontSize="13"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 모드 세그먼트 + 계정 정보 -->
        <Grid Grid.Row="0">
            <Border CornerRadius="9" Background="#FFEDF0F5" Padding="4"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbEnc" GroupName="Mode" Style="{StaticResource Segment}"
                                 Content="파일 → 텍스트" IsChecked="True" Checked="Mode_Checked"/>
                    <RadioButton x:Name="RbDec" GroupName="Mode" Style="{StaticResource Segment}"
                                 Content="텍스트 → 파일" Checked="Mode_Checked"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="TxtAccount" VerticalAlignment="Center" Margin="0,0,10,0"
                           FontSize="12" Foreground="{StaticResource Text2}"/>
                <Button x:Name="BtnAccount" Content="계정 정보 관리" Padding="12,6"
                        Click="BtnAccount_Click"/>
            </StackPanel>
        </Grid>

        <!-- 설명 -->
        <TextBlock x:Name="TxtHint" Grid.Row="1" Margin="2,12,0,10"
                   Foreground="{StaticResource Text2}" TextWrapping="Wrap"/>

        <!-- 왼쪽 폴더 트리(묶기 탭) + 드롭 존·목록 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColTree" Width="0" MinWidth="0"/>
                <ColumnDefinition x:Name="ColSplit" Width="0"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 넣은 파일들의 폴더. 체크한 폴더의 파일만 처리한다(끈 폴더는 목록에 흐리게 "제외"). -->
            <Border x:Name="TreePane" Grid.Column="0" Visibility="Collapsed"
                    Background="{StaticResource Panel}" BorderBrush="{StaticResource Border1}"
                    BorderThickness="1.5" CornerRadius="10">
                <DockPanel Margin="6">
                    <DockPanel DockPanel.Dock="Top" Margin="4,2,2,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="모두" Padding="6,1" FontSize="11.5" Click="TreeAll_Click"
                                    ToolTip="모든 폴더를 처리에 넣습니다"/>
                            <Button Content="해제" Padding="6,1" FontSize="11.5" Margin="4,0,0,0" Click="TreeNone_Click"
                                    ToolTip="모든 폴더를 처리에서 뺍니다"/>
                        </StackPanel>
                        <TextBlock Text="폴더" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{StaticResource Text1}"/>
                    </DockPanel>
                    <TreeView x:Name="TvFolders" BorderThickness="0" Background="Transparent"
                              PreviewKeyDown="TvFolders_PreviewKeyDown"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type local:FolderNode}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}">
                                    <CheckBox IsChecked="{Binding State, Mode=TwoWay}" VerticalAlignment="Center"
                                              Margin="0,0,5,0" Focusable="False"/>
                                    <Image Source="{x:Static local:ShellIcons.Folder}" Width="16" Height="16"
                                           Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="TreeSplit" Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          Background="Transparent" Visibility="Collapsed" ResizeBehavior="PreviousAndNext"/>

        <Border x:Name="DropZone" Grid.Column="2" AllowDrop="True"
                Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Border1}" BorderThickness="1.5"
                CornerRadius="10"
                DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave"
                DragOver="DropZone_DragOver" Drop="DropZone_Drop">
            <Grid>
                <StackPanel x:Name="EmptyPane" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtEmptyIcon" Text="⬇" FontSize="34" HorizontalAlignment="Center"
                               Foreground="{StaticResource Border1}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtEmptyTitle" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="{StaticResource Text1}"/>
                    <TextBlock x:Name="TxtEmptySub" Margin="0,6,0,0" HorizontalAlignment="Center"
                               TextAlignment="Center" Foreground="{StaticResource Text2}"/>
                </StackPanel>

                <!-- 열 머리글을 누르면 그 기준으로 정렬(다시 누르면 반대로) -->
                <ListView x:Name="LvItems" Background="Transparent" BorderThickness="0"
                          Margin="8" SelectionMode="Extended" Visibility="Collapsed"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          GridViewColumnHeader.Click="LvHeader_Click">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Opacity" Value="{Binding RowOpacity}"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="상태" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Badge}" Background="{Binding BadgeBg}">
                                            <TextBlock Text="{Binding KindText}" FontSize="11.5"
                                                       FontWeight="SemiBold" Foreground="{Binding BadgeFg}"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="파일" Width="300">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0"
                                                   VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Display}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="확장자" Width="70" DisplayMemberBinding="{Binding Extension}"/>
                            <GridViewColumn Header="크기" Width="85"  DisplayMemberBinding="{Binding SizeText}"/>
                            <GridViewColumn Header="위치" Width="230" DisplayMemberBinding="{Binding Folder}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
        </Grid>

        <!-- 목록 버튼 + 경로로 추가 -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnAddFiles"  Content="파일 추가"  Click="BtnAddFiles_Click"/>
                <Button x:Name="BtnAddFolder" Content="폴더 추가"  Click="BtnAddFolder_Click"/>
                <Button x:Name="BtnFromClip"  Content="클립보드에서 가져오기" Click="BtnFromClip_Click"/>
                <Button x:Name="BtnRemove"    Content="선택 삭제"  Click="BtnRemove_Click"/>
                <Button x:Name="BtnClear"     Content="전체 삭제"  Click="BtnClear_Click"/>
                <TextBlock x:Name="TxtCount" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="{StaticResource Text2}"/>
            </StackPanel>

            <!-- 절대 경로를 직접 넣어 추가. 여러 개는 줄바꿈·';'·따옴표로 구분. Enter = 추가, Shift+Enter = 줄바꿈 -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="경로" VerticalAlignment="Center" Width="56"
                           Margin="0,0,10,0" Foreground="{StaticResource Text2}"/>
                <Grid Grid.Column="1">
                    <TextBox x:Name="TxtPaths" AcceptsReturn="True" MaxHeight="72" MinHeight="26"
                             VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                             VerticalContentAlignment="Center" Padding="4,3"
                             PreviewKeyDown="TxtPaths_PreviewKeyDown" TextChanged="TxtPaths_TextChanged"/>
                    <TextBlock x:Name="TxtPathsHint" IsHitTestVisible="False" Margin="8,0,0,0"
                               VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Text2}"
                               Text="C:\자료\보고서.xlsx 처럼 절대 경로를 넣고 Enter  (여러 개는 줄바꿈 · ; · 따옴표로 구분, 폴더도 됨)"/>
                </Grid>
                <Button Grid.Column="2" x:Name="BtnAddPaths" Content="경로 추가" Margin="6,0,0,0"
                        Click="BtnAddPaths_Click"/>
            </Grid>
        </StackPanel>

        <!-- 저장 폴더 -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="저장 폴더" VerticalAlignment="Center" Width="56"
                       Margin="0,0,10,0" Foreground="{StaticResource Text2}"/>
            <TextBox   Grid.Column="1" x:Name="TxtOutDir"/>
            <Button    Grid.Column="2" x:Name="BtnBrowseOut" Content="찾아보기..." Margin="6,0,0,0" Click="BtnBrowseOut_Click"/>
        </Grid>

        <!-- 실행 -->
        <Border Grid.Row="5" Margin="0,14,0,0" CornerRadius="8" Padding="14,12"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource Border1}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtPlan" FontWeight="SemiBold" Foreground="{StaticResource Text1}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtStatus" Margin="0,4,0,0" Foreground="{StaticResource Text2}"
                               TextWrapping="Wrap" MaxHeight="42"/>
                    <ProgressBar x:Name="Bar" Height="4" Margin="0,8,0,0" Visibility="Collapsed"
                                 Foreground="{StaticResource Accent}" Background="#FFE6EAF0" BorderThickness="0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox x:Name="ChkArchive" IsChecked="False"
                                  Content="하나로 묶기 (폴더 권장)" VerticalAlignment="Center"
                                  FontSize="12" Foreground="{StaticResource Text2}"
                                  Checked="ChkArchive_Changed" Unchecked="ChkArchive_Changed"/>
                        <CheckBox x:Name="ChkClipboard" IsChecked="True" Margin="18,0,0,0"
                                  Content="결과를 클립보드에 복사" VerticalAlignment="Center"
                                  FontSize="12" Foreground="{StaticResource Text2}"/>
                        <TextBlock Text="조각내기" VerticalAlignment="Center" Margin="18,0,6,0"
                                   FontSize="12" Foreground="{StaticResource Text2}"/>
                        <ComboBox x:Name="CbSplitSize" Width="210" FontSize="12"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="ChkSplit_Changed">
                            <!-- "항상 N자씩" 은 뺐다. 결과가 N자 이하일 때 조각 1개짜리를 만든다는 것 말고는
                                 "N자 넘으면 나눔" 과 결과가 같았다. -->
                            <ComboBoxItem Content="안 함 (항상 한 덩어리)" Tag="0"/>
                            <ComboBoxItem Content="5만 자 넘으면 나눔"  Tag="A50000"/>
                            <ComboBoxItem Content="10만 자 넘으면 나눔" Tag="A100000"/>
                            <ComboBoxItem Content="20만 자 넘으면 나눔" Tag="A200000" IsSelected="True"/>
                            <ComboBoxItem Content="50만 자 넘으면 나눔" Tag="A500000"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnNetcus" MinWidth="150" Margin="18,0,0,0" FontSize="13"
                            VerticalAlignment="Center" Click="BtnNetcus_Click"/>
                    <Button x:Name="BtnRun" Style="{StaticResource PrimaryButton}"
                            FontSize="14" MinWidth="160" Margin="8,0,0,0"
                            VerticalAlignment="Center" Click="BtnRun_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
