<Window x:Class="FileCrypt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileCrypt" Height="640" Width="880" MinHeight="520" MinWidth="720"
        Background="{StaticResource Bg}"
        FontFamily="Malgun Gothic" FontSize="13"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 모드 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="RbEncrypt" GroupName="Mode" IsChecked="True"
                         Content="파일 → 텍스트" FontWeight="SemiBold" FontSize="14"
                         VerticalContentAlignment="Center" Margin="0,0,20,0"
                         Checked="Mode_Changed"/>
            <RadioButton x:Name="RbDecrypt" GroupName="Mode"
                         Content="텍스트 → 파일" FontWeight="SemiBold" FontSize="14"
                         VerticalContentAlignment="Center"
                         Checked="Mode_Changed"/>
        </StackPanel>

        <!-- 안내 -->
        <TextBlock x:Name="TxtHint" Grid.Row="1" Margin="0,0,0,8"
                   Foreground="{StaticResource Text2}" TextWrapping="Wrap"
                   Text="옮기고 싶은 파일을 아래에 끌어다 놓거나 [파일 추가]를 누르세요. 여러 개를 한 번에 처리합니다."/>

        <!-- 드롭 존 + 목록 -->
        <Border x:Name="DropZone" Grid.Row="2" AllowDrop="True"
                Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Border1}" BorderThickness="1.5"
                CornerRadius="8"
                DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave"
                DragOver="DropZone_DragOver" Drop="DropZone_Drop">
            <Grid>
                <TextBlock x:Name="TxtEmpty" Foreground="{StaticResource Text2}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" FontSize="14"
                           Text="여기로 파일을 끌어다 놓으세요&#x0a;(폴더도 됩니다)"/>

                <ListView x:Name="LvItems" Background="Transparent" BorderThickness="0"
                          Margin="6" SelectionMode="Extended" Visibility="Collapsed"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="파일" Width="470"
                                            DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="크기" Width="100"
                                            DisplayMemberBinding="{Binding SizeText}"/>
                            <GridViewColumn Header="위치" Width="240"
                                            DisplayMemberBinding="{Binding Folder}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- 목록 버튼 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="BtnAddFiles"  Content="파일 추가"   Click="BtnAddFiles_Click"/>
            <Button x:Name="BtnAddFolder" Content="폴더 추가"   Click="BtnAddFolder_Click"/>
            <Button x:Name="BtnFromClip"  Content="클립보드에서 가져오기" Click="BtnFromClip_Click" Visibility="Collapsed"/>
            <Button x:Name="BtnRemove"    Content="선택 삭제"   Click="BtnRemove_Click"/>
            <Button x:Name="BtnClear"     Content="전체 삭제"   Click="BtnClear_Click"/>
            <TextBlock x:Name="TxtCount" VerticalAlignment="Center" Margin="10,0,0,0"
                       Foreground="{StaticResource Text2}"/>
        </StackPanel>

        <!-- 저장 경로 + 옵션 -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="저장 폴더" VerticalAlignment="Center"
                       Margin="0,0,10,0" Foreground="{StaticResource Text2}"/>
            <TextBox   Grid.Column="1" x:Name="TxtOutDir"/>
            <Button    Grid.Column="2" Content="찾아보기..." Margin="6,0,0,0" Click="BtnBrowseOut_Click"/>
        </Grid>

        <!-- 실행 -->
        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0" x:Name="ChkClipboard" IsChecked="True"
                      Content="결과 텍스트를 클립보드에 복사" VerticalAlignment="Center"
                      Foreground="{StaticResource Text2}" Margin="0,0,16,0"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TxtStatus" Foreground="{StaticResource Text2}" TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="Bar" Height="4" Margin="0,6,0,0" Visibility="Collapsed"
                             Foreground="{StaticResource Accent}" Background="#FFE6EAF0" BorderThickness="0"/>
            </StackPanel>

            <Button Grid.Column="2" x:Name="BtnRun" Content="실행" Style="{StaticResource PrimaryButton}"
                    Margin="16,0,0,0" Click="BtnRun_Click"/>
        </Grid>
    </Grid>
</Window>
